# NoCodeBackend (server-only — never use NEXT_PUBLIC_* for these)
NCB_INSTANCE=your_ncb_database_instance
NCB_AUTH_API_URL=https://app.nocodebackend.com/api/user-auth
NCB_DATA_API_URL=https://app.nocodebackend.com/api/data
NCB_APP_URL=https://app.nocodebackend.com
NCB_SECRET_KEY=your_ncb_secret_key

# Public API base URL used when deploying endpoints
PROMPT_PILOT_API_URL=https://api.promptpilot.com
PROMPT_PILOT_BASE_DOMAIN=api.promptpilot.com
PROMPT_PILOT_CNAME_TARGET=cname.api.promptpilot.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LLM providers
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
COHERE_API_KEY=your_cohere_api_key
