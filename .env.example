# NoCodeBackend (server-only — never use NEXT_PUBLIC_* for these)
NCB_INSTANCE=your_ncb_database_instance
NCB_AUTH_API_URL=https://app.nocodebackend.com/api/user-auth
NCB_DATA_API_URL=https://app.nocodebackend.com/api/data
NCB_APP_URL=https://app.nocodebackend.com
NCB_SECRET_KEY=your_ncb_secret_key

# Public API base URL used when deploying endpoints
PROMPT_PILOT_API_URL=https://beta.promptpilot.run
PROMPT_PILOT_BASE_DOMAIN=beta.promptpilot.run
PROMPT_PILOT_CNAME_TARGET=cname.beta.promptpilot.run
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_DOMAIN=beta.promptpilot.run

# LLM providers
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
COHERE_API_KEY=your_cohere_api_key

# --- Multi-tenant domain setup (production) ---
# 1. Vercel/hosting: add wildcard *.beta.promptpilot.run + cname.beta.promptpilot.run
# 2. Vanity workspace: https://{org}.beta.promptpilot.run (dashboard + app)
# 3. Custom API domain per org:
#    CNAME  api.customer.com  →  cname.beta.promptpilot.run
#    TXT    _promptpilot-challenge.api.customer.com  →  promptpilot-site-verification=pp-verify-...
# 4. After login on the platform URL, users redirect to their vanity workspace URL.
